{
  "name": "dsh-study-desk",
  "version": "0.1.0",
  "description": "考研工作台：Notion 式待办墙（待办/进行中/已完成）+ 按复习时长点亮的学习热力图 + 跨面板存活的番茄钟，只消费主题 token，融入现有主题而不改主题。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "study",
    "kanban",
    "pomodoro",
    "heatmap",
    "kaoyan"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "index.js",
    "desk.js",
    "timer.js",
    "test/",
    "README.md"
  ]
}
