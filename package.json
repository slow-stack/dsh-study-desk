{
  "name": "dsh-study-desk",
  "version": "0.2.0",
  "description": "考研工作台：Notion 式待办墙 + 间隔重复复习队列 + 按复习时长点亮的热力图与周报 + 每日复盘 + Markdown 导出读回 + 跨面板存活的番茄钟，只消费主题 token，融入现有主题而不改主题。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "study",
    "kanban",
    "pomodoro",
    "heatmap",
    "spaced-repetition",
    "obsidian",
    "markdown",
    "kaoyan"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slow-stack/dsh-study-desk.git"
  },
  "bugs": {
    "url": "https://github.com/slow-stack/dsh-study-desk/issues"
  },
  "homepage": "https://github.com/slow-stack/dsh-study-desk#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "index.js",
    "desk.js",
    "markdown.js",
    "timer.js",
    "test/",
    "README.md",
    "CHANGELOG.md"
  ]
}
